{
  "name": "skillsy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "NEXT_PUBLIC_USE_EMULATORS=1 firebase emulators:exec --only firestore,auth,storage --ui \"node scripts/emulator-seed.mjs && next dev\"",
    "emulators:refresh": "firebase emulators:exec --only firestore,auth \"node scripts/emulator-seed.mjs --refresh\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-skillsy \"node --test tests/rules/*.test.mjs\"",
    "clean": "next clean",
    "deploy:firestore-rules": "firebase deploy --only firestore --project gen-lang-client-0463625624",
    "backfill:public-profiles": "node scripts/backfill-public-profiles.mjs",
    "backfill:user-public-visibility": "node scripts/backfill-user-public-visibility.mjs",
    "backfill:user-verification": "node scripts/backfill-user-verification.mjs",
    "inspect:public-profiles": "node scripts/inspect-public-profiles.mjs",
    "inspect:public-profile-consistency": "node scripts/inspect-public-profile-consistency.mjs",
    "inspect:user-profile-shape": "node scripts/inspect-user-profile-shape.mjs",
    "inspect:user-verification": "node scripts/inspect-users-verification.mjs",
    "i18n:check": "node scripts/i18n/check.mjs && node scripts/i18n/build-functions.mjs --check",
    "i18n:export": "node scripts/i18n/export.mjs",
    "i18n:import": "node scripts/i18n/import.mjs",
    "test:i18n": "node --test tests/i18n/*.test.mjs",
    "i18n:export-legal": "node scripts/i18n/export-legal.mjs",
    "i18n:functions": "node scripts/i18n/build-functions.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@hookform/resolvers": "^7.0.7",
    "@shadcn/react": "^0.3.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^13.4.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.75.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.6.0",
    "react-resizable-panels": "^4.24.1",
    "recharts": "^3.11.0",
    "shadcn": "^4.18.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "firebase-tools": "^15.36.0",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
